<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup rules for KashCube.

  STRATEGY: Exclude-only (no <include> tags).
  When only <exclude> rules are present, Android backs up EVERYTHING
  in the app's data directories EXCEPT what is explicitly excluded.
  This automatically covers:
    - kash_cube.db          (active FY database)
    - kash_cube_archive_FY*.db  (year-end archives created by closing wizard)

  EXCLUDED (to stay under the 25 MB Android Auto Backup limit):
    - images/                   — user-importable; can be large
    - pdfs/                     — ephemeral PDFs; always re-generatable from DB
    - kash_cube_prev.db         — rolling daily snapshot; not needed in backup
    - kash_cube_before_restore.db — pre-restore safety copy; temporary

  Typical sizes:
    kash_cube.db            1–5 MB
    archive_FY*.db          1–5 MB each (one per year)
    Total (5-year history)  ~25 MB — within Android's limit
-->
<full-backup-content>
    <exclude domain="file" path="images/" />
    <exclude domain="file" path="pdfs/" />
    <exclude domain="database" path="kash_cube_prev.db" />
    <exclude domain="database" path="kash_cube_before_restore.db" />
</full-backup-content>
