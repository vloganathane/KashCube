<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data extraction rules for KashCube.
  Controls what is included in cloud backups AND device-to-device transfers.

  Mirrors backup_rules.xml: include active DB, exclude images/PDFs/snapshots.
-->
<data-extraction-rules>
    <!--
      Exclude-only strategy: Android backs up EVERYTHING except the listed paths.
      This covers kash_cube.db and all kash_cube_archive_FY*.db files automatically.
      Do NOT add <include> elements — mixing include+exclude across domains triggers
      the FullBackupContent lint check ("path is not in an included path").
    -->
    <cloud-backup>
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="pdfs/" />
        <exclude domain="file" path="backups/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="database" path="kash_cube_prev.db" />
        <exclude domain="database" path="kash_cube_before_restore.db" />
        <exclude domain="database" path="kash_cube.db-wal" />
        <exclude domain="database" path="kash_cube.db-shm" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="pdfs/" />
        <exclude domain="file" path="backups/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="database" path="kash_cube_prev.db" />
        <exclude domain="database" path="kash_cube_before_restore.db" />
        <exclude domain="database" path="kash_cube.db-wal" />
        <exclude domain="database" path="kash_cube.db-shm" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
