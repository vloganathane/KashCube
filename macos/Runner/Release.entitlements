<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Camera access for QR code scanning -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- LAN sync: KashCube Web HTTP server + WebSocket server -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- LAN sync: outbound connections to paired secondaries / browser clients -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- File operations: backup import/export, PDF save, GSTR CSV export -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Downloads folder read/write for exported reports -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
